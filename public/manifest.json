{
  "manifest_version": 3,
  "name": "donuTool",
  "version": "1.0.4",
  "description": "donuTool is a floating cursor-following toolbar that offers instant, overlay-based access to essential tools.",
  "icons": {
    "16": "assets/donuTool-logo-white.png",
    "32": "assets/donuTool-logo-white.png",
    "48": "assets/donuTool-logo-white.png",
    "128": "assets/donuTool-logo-white.png"
  },
  "oauth2": {
    "client_id": "REMOVED",
    "scopes": [""]
  },
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/donuToolBar.png", "assets/*.svg"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "tabs",
    "bookmarks",
    "clipboardWrite",
    "downloads",
    "identity"
  ],
  "host_permissions": ["<all_urls>"],
  "key": "REMOVED"
}
